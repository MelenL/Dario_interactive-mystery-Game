# hf = hosted Hugging Face Inference Providers; local = Transformers on this machine.
MODEL_BACKEND=hf
HF_TOKEN=
HF_MODEL_ID=openai/gpt-oss-120b
HF_PROVIDER=auto
HF_TIMEOUT_SECONDS=90

# Only read when MODEL_BACKEND=local. First use downloads model weights.
LOCAL_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
LOCAL_DEVICE=cpu

# Embeddings are computed locally in both modes; first use downloads this model.
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
RETRIEVAL_K=3
MAX_GENERATION_TOKENS=3500

HOST=127.0.0.1
PORT=7860
# Set both when intentionally exposing the server beyond localhost.
APP_USERNAME=
APP_PASSWORD=
# Optional replacement JSON corpus; bundled examples are used by default.
CORPUS_PATH=
LANGSMITH_TRACING=false
HF_HUB_DISABLE_TELEMETRY=1
GRADIO_ANALYTICS_ENABLED=False
